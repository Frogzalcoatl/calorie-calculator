# Vibe coded ah gitignore

# --- Build Output Directories ---
# Ignores the 'x64' folder found at the root and inside the project folder
x64/
Debug/
Release/
.vs/

# --- Build Artifacts (Files) ---
*.exe
*.dll
*.pdb
*.metagen
*.obj
*.log
*.tlog
*.cache
*.recipe
*.lastbuildstate
*.idb
*.ipch

# --- Visual Studio Specific ---
# User-specific configuration (Assignment8_COP3003.vcxproj.user)
*.user
*.suo
*.userosscache
*.sln.docstates

# --- Temporary/generated source files ---
# These are generated by the build process inside Debug/
*.AssemblyAttributes.cpp
*.FileListAbsolute.txt